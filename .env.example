# ============================================================
# AI COMMAND CENTER - ENVIRONMENT CONFIGURATION
# ============================================================

# Application
APP_NAME=AI_COMMAND_CENTER
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/ai_command_center

# AI Provider
AI_PROVIDER=ollama
AI_MODEL=llama3.1

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Security
JWT_SECRET=
JWT_ACCESS_EXPIRES_MINUTES=30

# RAG
VECTOR_DB_PATH=./data/vector_store

# Workspace
WORKSPACE_ROOT=./workspace

# Agent Execution
MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=20
COMMAND_TIMEOUT_SECONDS=120

# Self-Correction
MAX_RETRY_ATTEMPTS=3

# Human Approval
REQUIRE_APPROVAL_FOR_WRITE=true
REQUIRE_APPROVAL_FOR_DELETE=true
REQUIRE_APPROVAL_FOR_EXTERNAL_ACTION=true